# ============================================================================
# .gitignore для Python-проекта с Jupyter Notebook
# mml-companion-notes
# ============================================================================

# --- Виртуальные окружения -------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# --- Кэш Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Временные файлы -------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*~

# --- Системные файлы -------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# --- Настройки IDE ---------------------------------------------------------
.vscode/
*.code-workspace
.idea/
*.iml
*.iws
*.ipr
out/
.jupyter/
.ipynb_checkpoints/
*.ipynb_checkpoints
.spyderproject
.spyproject
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/

# --- Файлы вывода Jupyter Notebook ----------------------------------------
notebooks/**/*.nbconvert.ipynb
notebooks/**/*.html
notebooks/**/*.pdf

# --- Каталоги pytest -------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- Окружение и переменные ------------------------------------------------
.env
.env.local
.env.*.local
*.env

# --- Документация ----------------------------------------------------------
docs/_build/
site/

# --- Прочее ----------------------------------------------------------------
.cache/
*.pid
*.seed
*.pid.lock
